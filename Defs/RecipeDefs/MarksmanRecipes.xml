<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef ParentName="SE_UpgradeRecipeBase">
    <defName>SE_MakeMarksmanSerum</defName>
    <label>make marksman serum</label>
    <description>Produce marksman serum at a serum lab by conditioning twisted meat and bioferrite.</description>
    <jobString>Making marksman serum.</jobString>
    <workAmount>1080</workAmount>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <researchPrerequisites>
      <li>SE_SerumRefinement</li>
      <li>JuggernautSerum</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Meat_Twisted</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Bioferrite</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Meat_Twisted</li>
        <li>Bioferrite</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <SE_MarksmanSerum>1</SE_MarksmanSerum>
    </products>
    <modExtensions>
      <li Class="SerumsExpended.AdaptiveSerumRecipe">
        <routes>
          <li>
            <work>1080</work>
            <ingredients>
              <Meat_Twisted>20</Meat_Twisted>
              <Bioferrite>10</Bioferrite>
            </ingredients>
          </li>
        </routes>
      </li>
    </modExtensions>
  </RecipeDef>

<Defs>
  <RecipeDef ParentName="SE_UpgradeRecipeBase">
    <defName>SE_SynthesizeRefinedJuggernautSerum</defName>
    <label>make refined juggernaut serum</label>
    <description>Produce refined juggernaut serum at a serum lab. Existing lower-tier doses can be upgraded with additional materials, or the serum can be synthesized from raw ingredients. Usable higher-tier preparations are preferred when available.</description>
    <jobString>Making refined juggernaut serum.</jobString>
    <workAmount>1980</workAmount>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
    <researchPrerequisites>
      <li>SE_SerumRefinement</li>
      <li>JuggernautSerum</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Meat_Twisted</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Bioferrite</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>JuggernautSerum</li>
        <li>Bioferrite</li>
        <li>Neutroamine</li>
        <li>Meat_Twisted</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <SE_RefinedJuggernautSerum>1</SE_RefinedJuggernautSerum>
    </products>
    <modExtensions>
      <li Class="SerumsExpended.AdaptiveSerumRecipe">
        <routes>
          <li>
            <work>900</work>
            <ingredients>
              <JuggernautSerum>1</JuggernautSerum>
              <Bioferrite>20</Bioferrite>
              <Neutroamine>4</Neutroamine>
            </ingredients>
          </li>
          <li>
            <work>1980</work>
            <ingredients>
              <Meat_Twisted>20</Meat_Twisted>
              <Bioferrite>30</Bioferrite>
              <Neutroamine>4</Neutroamine>
            </ingredients>
          </li>
        </routes>
      </li>
    </modExtensions>
    <recipeUsers Inherit="False" />
  </RecipeDef>

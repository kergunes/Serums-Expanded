<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef>
    <defName>SE_NeuroplasticComa</defName>
    <modExtensions>
      <li Class="VREAndroids.AndroidSettingsExtension" MayRequire="vanillaracesexpanded.android">
        <androidCanCatchIt>false</androidCanCatchIt>
      </li>
    </modExtensions>
    <label>neuroplastic coma</label>
    <description>Neuroplastic mechanites have rendered this person unconscious while they rewire the brain. When the treatment ends, a random skill will become a burning passion.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="SerumsExpended.NeuroplasticTimerProperties">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <chooseSkill>false</chooseSkill>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>SE_AdvancedNeuroplasticComa</defName>
    <modExtensions>
      <li Class="VREAndroids.AndroidSettingsExtension" MayRequire="vanillaracesexpanded.android">
        <androidCanCatchIt>false</androidCanCatchIt>
      </li>
    </modExtensions>
    <label>advanced neuroplastic coma</label>
    <description>Neuroplastic mechanites have rendered this person unconscious while they carefully rewire the brain around one chosen skill. When the treatment ends, that skill will become a burning passion.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="SerumsExpended.NeuroplasticTimerProperties">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <chooseSkill>true</chooseSkill>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>

<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef>
    <defName>SE_RegenesisComa</defName>
    <modExtensions>
      <li Class="VREAndroids.AndroidSettingsExtension" MayRequire="vanillaracesexpanded.android">
        <androidCanCatchIt>false</androidCanCatchIt>
      </li>
    </modExtensions>
    <label>regenerative coma</label>
    <description>Regenerative mechanites have rendered this person unconscious while they repair damaged tissue. When the treatment ends, they will attempt to repair a permanent injury on an existing body part.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="SerumsExpended.RegenesisTimerProperties">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <restoreMissingParts>false</restoreMissingParts>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>SE_AdvancedRegenesisComa</defName>
    <modExtensions>
      <li Class="VREAndroids.AndroidSettingsExtension" MayRequire="vanillaracesexpanded.android">
        <androidCanCatchIt>false</androidCanCatchIt>
      </li>
    </modExtensions>
    <label>advanced regenerative coma</label>
    <description>Regenerative mechanites have rendered this person unconscious while they rebuild lost tissue. When the treatment ends, they will attempt to restore a missing biological part or repair a permanent injury.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="SerumsExpended.RegenesisTimerProperties">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <restoreMissingParts>true</restoreMissingParts>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
